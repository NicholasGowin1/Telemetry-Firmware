CM_ "Haltech broadcast CAN protocol v2.0: 1 Mbit/s, 11-bit IDs, big-endian";
CM_ BU_ Haltech "Haltech Nexus/Elite ECU or VCU";
CM_ BO_ 867 "Bytes 4-5 unused.";
CM_ SG_ 875 NOSPressureSensor1 "y = x*11/50 - 101.3; saturates at 14316.4 kPa.";
CM_ SG_ 880 Gear "Low byte of the manual's \"Combined Gear\" (x & 0xFF).";
CM_ SG_ 880 GearSelectorPosition "High byte of the manual's \"Combined Gear\" (x >> 8) & 0xFF.";
CM_ SG_ 994 FuelLevel2 "The manual lists \"Fuel Level\" twice in this message.";
CM_ SG_ 999 GenericSensor4 "Scaling depends on the configured sensor type (see \"Generic Sensors\" table): raw value shown.";
CM_ SG_ 999 GenericSensor3 "Scaling depends on the configured sensor type (see \"Generic Sensors\" table): raw value shown.";
CM_ SG_ 999 GenericSensor2 "Scaling depends on the configured sensor type (see \"Generic Sensors\" table): raw value shown.";
CM_ SG_ 999 GenericSensor1 "Scaling depends on the configured sensor type (see \"Generic Sensors\" table): raw value shown.";
CM_ SG_ 1000 GenericSensor8 "Scaling depends on the configured sensor type (see \"Generic Sensors\" table): raw value shown.";
CM_ SG_ 1000 GenericSensor7 "Scaling depends on the configured sensor type (see \"Generic Sensors\" table): raw value shown.";
CM_ SG_ 1000 GenericSensor6 "Scaling depends on the configured sensor type (see \"Generic Sensors\" table): raw value shown.";
CM_ SG_ 1000 GenericSensor5 "Scaling depends on the configured sensor type (see \"Generic Sensors\" table): raw value shown.";
CM_ SG_ 1001 GenericSensor10 "Scaling depends on the configured sensor type (see \"Generic Sensors\" table): raw value shown.";
CM_ SG_ 1001 GenericSensor9 "Scaling depends on the configured sensor type (see \"Generic Sensors\" table): raw value shown.";
CM_ BO_ 1010 "Bytes 6-7 reserved.";
CM_ SG_ 1010 RideHeightFrontDerivative "Manual gives one x/10 conversion for the whole block.";
CM_ SG_ 1010 RideHeightFront "Reads 0 if there is an error (No Signal, Calibrating, Device Timeout). Needs Nexus 1.25 / Elite 3.11.";
CM_ BO_ 1011 "Bytes 6-7 reserved.";
CM_ SG_ 1011 RideHeightRearDerivative "Manual gives one x/10 conversion for the whole block.";
CM_ SG_ 1011 RideHeightRear "Reads 0 if there is an error (No Signal, Calibrating, Device Timeout). Needs Nexus 1.25 / Elite 3.11.";
CM_ SG_ 1138 CruiseControlInputState "Bit-field per manual.";
CM_ SG_ 1142 BrakePressureDifference "Front minus rear.";
CM_ SG_ 1143 CutPercentageFunction "Values per the Haltech \"Engine Limiting Functions\" table (not included in the protocol document).";
CM_ SG_ 1143 RPMLimiterFunction "Values per the Haltech \"Engine Limiting Functions\" table (not included in the protocol document).";
CM_ SG_ 1143 EngineLimiterFunction "Values per the Haltech \"Engine Limiting Functions\" table (not included in the protocol document).";
CM_ SG_ 1776 RearRightTyrePressure "0 = error (No Signal, Calibrating or Device Timeout); otherwise converted value.";
CM_ SG_ 1776 RearLeftTyrePressure "0 = error (No Signal, Calibrating or Device Timeout); otherwise converted value.";
CM_ SG_ 1776 FrontRightTyrePressure "0 = error (No Signal, Calibrating or Device Timeout); otherwise converted value.";
CM_ SG_ 1776 FrontLeftTyrePressure "0 = error (No Signal, Calibrating or Device Timeout); otherwise converted value.";
CM_ SG_ 1777 RearRightTyreTemperature "0 = error (No Signal, Calibrating or Device Timeout); otherwise converted value.";
CM_ SG_ 1777 RearLeftTyreTemperature "0 = error (No Signal, Calibrating or Device Timeout); otherwise converted value.";
CM_ SG_ 1777 FrontRightTyreTemperature "0 = error (No Signal, Calibrating or Device Timeout); otherwise converted value.";
CM_ SG_ 1777 FrontLeftTyreTemperature "0 = error (No Signal, Calibrating or Device Timeout); otherwise converted value.";
CM_ SG_ 1778 RearRightTyreSensorBatteryVoltag "0 = error (No Signal, Calibrating or Device Timeout); otherwise converted value.";
CM_ SG_ 1778 RearLeftTyreSensorBatteryVoltage "0 = error (No Signal, Calibrating or Device Timeout); otherwise converted value.";
CM_ SG_ 1778 FrontRightTyreSensorBatteryVolta "0 = error (No Signal, Calibrating or Device Timeout); otherwise converted value.";
CM_ SG_ 1778 FrontLeftTyreSensorBatteryVoltag "0 = error (No Signal, Calibrating or Device Timeout); otherwise converted value.";
CM_ SG_ 1779 EngineProtectionReason "OBDII DTC: upper 2 bits = letter (0 P, 1 B, 2 C, 3 U), remaining 14 bits = code in hex, e.g. 0x2A00 = P2A00.";
CM_ SG_ 1780 EngineState "Manual writes the range as 1:0-1:3; taken as byte 1 bits 3..0.";
CM_ SG_ 1783 GenericOutputStates "Bit X = generic output X+1; 1 = on (>=0.1% duty or >=1 Hz).";
CM_ BO_ 1784 "Byte 5 reserved.";
CM_ BO_ 1785 "Bytes 2-7 reserved.";
CM_ SG_ 1791 PowerSteeringPressure "Note x/100 scaling for this channel.";
CM_ SG_ 1791 TorqueConverterPressure "0 = error (No Signal, Calibrating or Device Timeout); otherwise converted value.";
CM_ SG_ 1792 PDMWord3 "HBO/HCO8/HCO25 data for the internal R5 PDM; see Haltech \"Multiplexed CAN protocol\".";
CM_ SG_ 1792 PDMWord2 "HBO/HCO8/HCO25 data for the internal R5 PDM; see Haltech \"Multiplexed CAN protocol\".";
CM_ SG_ 1792 PDMWord1 "HBO/HCO8/HCO25 data for the internal R5 PDM; see Haltech \"Multiplexed CAN protocol\".";
CM_ SG_ 1792 PDMWord0 "HBO/HCO8/HCO25 data for the internal R5 PDM; see Haltech \"Multiplexed CAN protocol\".";
CM_ SG_ 1793 FuelConsumptionInstantaneousMile "Manual gives bytes \"5 - 6\", which overlaps the previous signal; taken as bytes 6-7.";
